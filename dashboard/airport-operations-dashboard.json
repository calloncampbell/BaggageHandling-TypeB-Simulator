  "queries": [
    {
      "id": "c46a3e4a-0540-58a8-8228-4eb1afed479b",
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "70f6906c-3410-58b9-b0c6-23ac00eab16b"
      },
      "text": "['Airport.Passenger.Checkin_v1']\n| where ingestion_time() between (_startTime .. _endTime)\n| extend ingest = ingestion_time()\n| where ingest between (_startTime .. _endTime)\n| where (isempty(_airline) or airline in (_airline)) and (isempty(_origin) or origin in (_origin))\n| summarize Passengers = dcount(paxId)",
      "usedVariables": [
        "_startTime",
        "_endTime",
        "_airline",
        "_origin"
      ]
    },
    {
      "id": "5c04b587-f4b0-511d-b91c-aa70865c6dbf",
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "70f6906c-3410-58b9-b0c6-23ac00eab16b"
      },
      "text": "dash_bag_events(_startTime, _endTime)\n| where ingest between (_startTime .. _endTime)\n| where (isempty(_airline) or airline in (_airline)) and (isempty(_origin) or origin in (_origin))\n| where stage == 'Checkin'\n| summarize ['Bags'] = dcount(bagId)",
      "usedVariables": [
        "_startTime",
        "_endTime",
        "_airline",
        "_origin"
      ]
    },
    {
      "id": "2940a03a-3ffa-52df-a01d-015ab8d2617b",
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "70f6906c-3410-58b9-b0c6-23ac00eab16b"
      },
      "text": "dash_bag_events(_startTime, _endTime)\n| where ingest between (_startTime .. _endTime)\n| where (isempty(_airline) or airline in (_airline)) and (isempty(_origin) or origin in (_origin))\n| where stage == 'Loaded'\n| summarize ['Bags'] = dcount(bagId)",
      "usedVariables": [
        "_startTime",
        "_endTime",
        "_airline",
        "_origin"
      ]
    },
    {
      "id": "f13027d4-ca20-5e97-a9e4-529faf5461f8",
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "70f6906c-3410-58b9-b0c6-23ac00eab16b"
      },
      "text": "dash_bag_events(_startTime, _endTime)\n| where ingest between (_startTime .. _endTime)\n| where (isempty(_airline) or airline in (_airline)) and (isempty(_origin) or origin in (_origin))\n| where stage == 'Delivered'\n| summarize ['Bags'] = dcount(bagId)",
      "usedVariables": [
        "_startTime",
        "_endTime",
        "_airline",
        "_origin"
      ]
    },
    {
      "id": "96f7c89e-df07-5669-a97a-81d24a87f6d4",
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "70f6906c-3410-58b9-b0c6-23ac00eab16b"
      },
      "text": "dash_bag_state(_startTime, _endTime)\n| where firstIngest between (_startTime .. _endTime)\n| where (isempty(_airline) or airline in (_airline)) and (isempty(_origin) or origin in (_origin))\n| summarize Exceptions = countif(isException)",
      "usedVariables": [
        "_startTime",
        "_endTime",
        "_airline",
        "_origin"
      ]
    },
    {
      "id": "45880be1-5ed9-5168-8bf3-19214ce4dc6a",
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "70f6906c-3410-58b9-b0c6-23ac00eab16b"
      },
      "text": "dash_bag_state(_startTime, _endTime)\n| where firstIngest between (_startTime .. _endTime)\n| where (isempty(_airline) or airline in (_airline)) and (isempty(_origin) or origin in (_origin))\n| summarize Rate = round(100.0 * countif(isException) / count(), 2)\n| project ['Mishandled %'] = Rate",
      "usedVariables": [
        "_startTime",
        "_endTime",
        "_airline",
        "_origin"
      ]
    },
    {
      "id": "fccb6c64-1a79-52d6-8805-93f6d7f71761",
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "70f6906c-3410-58b9-b0c6-23ac00eab16b"
      },
      "text": "dash_bag_events(_startTime, _endTime)\n| where ingest between (_startTime .. _endTime)\n| where (isempty(_airline) or airline in (_airline)) and (isempty(_origin) or origin in (_origin))\n| summarize Bags = dcount(bagId) by Time = bin(ingest, 1m), stage\n| order by Time asc",
      "usedVariables": [
        "_startTime",
        "_endTime",
        "_airline",
        "_origin"
      ]
    },
    {
      "id": "65134a0f-1208-5cf5-8704-7bb9211137fa",
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "70f6906c-3410-58b9-b0c6-23ac00eab16b"
      },
      "text": "dash_bag_events(_startTime, _endTime)\n| where ingest between (_startTime .. _endTime)\n| where (isempty(_airline) or airline in (_airline)) and (isempty(_origin) or origin in (_origin))\n| where stage in ('Checkin', 'Screened', 'Loaded', 'Unloaded', 'Delivered')\n| summarize Bags = dcount(bagId) by stage\n| extend ord = case(stage == 'Checkin', 1, stage == 'Screened', 2, stage == 'Loaded', 3, stage == 'Unloaded', 4, 5)\n| order by ord asc\n| project stage, Bags",
      "usedVariables": [
        "_startTime",
        "_endTime",
        "_airline",
        "_origin"
      ]
    },
    {
      "id": "29ff8fe8-4d60-574e-a335-9852666dca96",
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "70f6906c-3410-58b9-b0c6-23ac00eab16b"
      },
      "text": "let pax = ['Airport.Passenger.Checkin_v1']\n    | where ingestion_time() between (_startTime .. _endTime)\n    | extend ingest = ingestion_time()\n    | where ingest between (_startTime .. _endTime)\n| where (isempty(_airline) or airline in (_airline)) and (isempty(_origin) or origin in (_origin))\n    | summarize Count = dcount(paxId) by Time = bin(ingest, 1m)\n    | extend Series = 'Passengers';\nlet bags = dash_bag_events(_startTime, _endTime)\n    | where ingest between (_startTime .. _endTime)\n| where (isempty(_airline) or airline in (_airline)) and (isempty(_origin) or origin in (_origin))\n    | where stage == 'Checkin'\n    | summarize Count = dcount(bagId) by Time = bin(ingest, 1m)\n    | extend Series = 'Bags';\nunion pax, bags\n| order by Time asc",
      "usedVariables": [
        "_startTime",
        "_endTime",
        "_airline",
        "_origin"
      ]
    },
    {
      "id": "b4f3417e-58cc-5968-b892-355bbc220758",
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "70f6906c-3410-58b9-b0c6-23ac00eab16b"
      },
      "text": "dash_bag_events(_startTime, _endTime)\n| where ingest between (_startTime .. _endTime)\n| where (isempty(_airline) or airline in (_airline)) and (isempty(_origin) or origin in (_origin))\n| where stage in ('Rejected', 'Lost', 'CustomsWithheld', 'NotCollected')\n| summarize Bags = dcount(bagId) by Time = bin(ingest, 1m), stage\n| order by Time asc",
