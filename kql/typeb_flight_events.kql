.create table typeb_flight_events (
    id: string,
    source: string,
    specversion: string,
    type: string,
    datacontenttype: string,    
    dataschema: string,
    subject: string,
    ['time']: datetime,
    data: dynamic,
    seriesclock: datetime
)

.alter table typeb_flight_events policy retention "{'SoftDeletePeriod': '36500.00:00:00', 'Recoverability': 'Enabled'}"

.alter table typeb_flight_events policy streamingingestion enable

.create-or-alter table typeb_flight_events ingestion json mapping "typeb_flight_events_mapping"
