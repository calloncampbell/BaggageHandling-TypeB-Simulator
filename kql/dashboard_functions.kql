// One row per bag with its check-in attributes (airline, route, weight).
// Only check-ins ingested at/after `_from` are read; callers pass a start earlier than their event window.
.create-or-alter function dash_bags_dim(_from: datetime) {
    ['Airport.Baggage.Checkin_v1']
    | where ingestion_time() >= _from
    | summarize arg_max(___time, *) by flightId, bagId
    | project flightId, bagId, flightNumber, airline, origin, destination, weightKg, paxId
}

// Bag lifecycle events ingested in [_from, _to], enriched with airline/origin/destination.
// Time filters run first on each table so the scan stays proportional to the window.
// Customs "cleared" is intentionally excluded (simulator emits type 'Airport.Baggage.Customs.Screened').
.create-or-alter function dash_bag_events(_from: datetime, _to: datetime) {
    union
        (['Airport.Baggage.Checkin_v1']          | where ingestion_time() between (_from .. _to) | project stage = 'Checkin',         flightId, bagId, ___time, ingest = ingestion_time()),
        (['Airport.Baggage.Screened_v1']         | where ingestion_time() between (_from .. _to) | project stage = 'Screened',        flightId, bagId, ___time, ingest = ingestion_time()),
        (['Airport.Baggage.Inspected_v1']        | where ingestion_time() between (_from .. _to) | project stage = 'Inspected',       flightId, bagId, ___time, ingest = ingestion_time()),
        (['Airport.Baggage.Rejected_v1']         | where ingestion_time() between (_from .. _to) | project stage = 'Rejected',        flightId, bagId, ___time, ingest = ingestion_time()),
        (['Airport.Baggage.Lost_v1']             | where ingestion_time() between (_from .. _to) | project stage = 'Lost',            flightId, bagId, ___time, ingest = ingestion_time()),
        (['Airport.Baggage.Loaded_v1']           | where ingestion_time() between (_from .. _to) | project stage = 'Loaded',          flightId, bagId, ___time, ingest = ingestion_time()),
        (['Airport.Baggage.Unloaded_v1']         | where ingestion_time() between (_from .. _to) | project stage = 'Unloaded',        flightId, bagId, ___time, ingest = ingestion_time()),
        (['Airport.Baggage.CustomsWithheld_v1']  | where ingestion_time() between (_from .. _to) | project stage = 'CustomsWithheld', flightId, bagId, ___time, ingest = ingestion_time()),
        (['Airport.Baggage.DeliveredOnBelt_v1']  | where ingestion_time() between (_from .. _to) | project stage = 'Delivered',       flightId, bagId, ___time, ingest = ingestion_time()),
        (['Airport.Baggage.NotCollected_v1']     | where ingestion_time() between (_from .. _to) | project stage = 'NotCollected',    flightId, bagId, ___time, ingest = ingestion_time())
    | lookup kind=leftouter (dash_bags_dim(_from - 1d)) on flightId, bagId
}

// One row per bag with a single, mutually exclusive state.
// Precedence: NotCollected > CustomsWithheld > Delivered > Lost > Rejected > Unloaded > Loaded > Screened > CheckedIn.
// Exception bags = Rejected, Lost, CustomsWithheld, NotCollected.
// Mishandled % = exception bags / all bags (see dashboard\README.md).
// Covers bags with at least one event ingested in [_from, _to].
.create-or-alter function dash_bag_state(_from: datetime, _to: datetime) {
    dash_bag_events(_from, _to)
    | summarize stages = make_set(stage), firstIngest = min(ingest), lastIngest = max(ingest), lastSimTime = max(___time)
        by flightId, bagId, flightNumber, airline, origin, destination, weightKg
    | extend state = case(
        set_has_element(stages, 'NotCollected'),   'NotCollected',
        set_has_element(stages, 'CustomsWithheld'), 'CustomsWithheld',
        set_has_element(stages, 'Delivered'),       'Delivered',
        set_has_element(stages, 'Lost'),            'Lost',
        set_has_element(stages, 'Rejected'),        'Rejected',
        set_has_element(stages, 'Unloaded'),        'Unloaded',
        set_has_element(stages, 'Loaded'),          'Loaded',
        set_has_element(stages, 'Screened'),        'Screened',
        'CheckedIn')
    | extend isException = state in ('NotCollected', 'CustomsWithheld', 'Lost', 'Rejected')
}
